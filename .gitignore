# ============================================================
# Common (applies to both rgb/ and ragbench/)
# ============================================================

# Environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Secrets
.env
*.env.local

# OS junk
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/

# ============================================================
# rgb/ — RGB benchmark track
# ============================================================

# Raw data (downloadable via rgb/scripts/download_data.py — kept out to stay lightweight)
rgb/data/raw/*.json

# Runtime LLM-call cache (regenerated automatically by the disk cache layer)
rgb/cache/*.json

# Generated result artifacts (regenerated by rgb/scripts/run_experiment.py & aggregate_results.py)
rgb/results/*.csv

# ============================================================
# ragbench/ — RAGBench track
# ============================================================

# Bulky generated pipeline artifacts (regenerated by running the numbered
# notebooks in order: 01 -> 02 -> 03 -> 04). Only lightweight *_summary.csv
# manifests are tracked for reference.
ragbench/datasets/**
ragbench/chunks/**
!ragbench/chunks/chunk_summary.csv
ragbench/embeddings/**
!ragbench/embeddings/embedding_summary.csv
ragbench/indexes/**
!ragbench/indexes/index_summary.csv
ragbench/judge_cache/
ragbench/experiments/
